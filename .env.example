# =====================================================
# ChiniDent - Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# .env is gitignored - NEVER commit real secrets.

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coni_saas?schema=public
DB_PASSWORD=postgres

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-64-char-random-string
JWT_REFRESH_SECRET=change-me-another-64-char-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- App ----
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- S3 File Storage ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=coni-saas-uploads

# ---- Email (SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@coni-saas.com

# ---- Admin Setup (first-run) ----
SEED_ADMIN_PASSWORD=
